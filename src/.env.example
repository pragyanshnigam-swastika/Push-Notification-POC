# Required: Firebase project ID used to build the FCM REST URL
# Example value: push-notification-poc-123ba
PROJECT_ID=push-notification-poc-123ba

# Optional but useful: HTTP server port for the Go API
# Example value: 8080
PORT=8080

# Local Redis Stream intake. Start Redis locally before running the service.
REDIS_ADDR=localhost:6379
# Set these in production when Redis requires ACL authentication or TLS.
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_STREAM=notification_requests
REDIS_GROUP=push-delivery
# Leave blank to generate a unique host/process name.
REDIS_CONSUMER_NAME=
# The default is 64 concurrent 1:1 FCM sends per service instance.
REDIS_BATCH_SIZE=64
REDIS_PARALLELISM=64
# Must be longer than the five-second FCM request timeout. This is the
# BASE delay before a failed message's first retry — actual retries use
# exponential backoff from this base, capped at REDIS_RECLAIM_MAX_SECONDS.
REDIS_RECLAIM_AFTER_SECONDS=10
# Upper bound on the exponential backoff between retries for one message.
REDIS_RECLAIM_MAX_SECONDS=300
# After this many delivery attempts, a message is moved to the
# "<REDIS_STREAM>:dead" stream instead of retried again.
REDIS_MAX_DELIVERY_ATTEMPTS=5

# Runtime credential options for Firebase Admin/FCM authentication.
# Choose ONE of the following ways to provide the service-account JSON.

# Option 1: place the full service-account JSON string inside the env var.
# Example value: a JSON object starting with {"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"push-notification-poc-123ba","private_key_id":"","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"","client_id":"1234567890","auth_uri":"","token_uri":"","auth_provider_x509_cert_url":"","client_x509_cert_url":""}

# Option 2: supply a base64-encoded service-account JSON blob.
# Example value: a base64 string returned from a command like base64 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwiY29tcGFueSI6bnVsbH0=

# Option 3: path to service-account.json visible to the runtime host.
# Example value: /etc/firebase/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
